# ==========================================
# MISTRI Platform - Environment Configuration
# ==========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Platform Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMS OTP Provider (sslwireless / greenweb / mock)
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=MISTRI

# Maps Configuration (Optional Leaflet / Mapbox / Google)
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-if-used

# Admin Root Credentials (For initial bootstrap script)
INITIAL_ADMIN_PHONE=+8801700000000
INITIAL_ADMIN_PASSWORD=change-this-secure-password

