# ==========================================
# MISTRI Platform - Environment Configuration
# ==========================================

# 1. Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Platform Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. Bangladesh SMS Gateway (sslwireless | greenweb | twilio | mock)
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=MISTRI
SMS_API_ENDPOINT=https://api.sms-provider.com/send

# 4. Storage Bucket Identifiers
NEXT_PUBLIC_STORAGE_DOCUMENTS_BUCKET=nid-documents
NEXT_PUBLIC_STORAGE_PORTFOLIOS_BUCKET=portfolios
NEXT_PUBLIC_STORAGE_AVATARS_BUCKET=avatars
NEXT_PUBLIC_STORAGE_BOOKING_PHOTOS_BUCKET=booking-photos

# 5. Firebase Authentication (Google Sign-In) & Cloud Messaging
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mistri24-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mistri24-portal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mistri24-portal.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# 6. Default Geographic Coordinates (Thakurgaon, Bangladesh)
NEXT_PUBLIC_DEFAULT_LATITUDE=26.0333
NEXT_PUBLIC_DEFAULT_LONGITUDE=88.4667
NEXT_PUBLIC_DEFAULT_DISTRICT=ঠাকুরগাঁও

# 7. Initial Super Admin Bootstrap Credentials
INITIAL_ADMIN_PHONE=+8801700000000
INITIAL_ADMIN_PASSWORD=change-this-secure-admin-password
